{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format:check)",
      "Bash(npm run format)",
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate)",
      "Bash(npm run db:seed)",
      "Bash(npm run db:studio)",
      "Bash(npx prisma*)",
      "Bash(npx tsc*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add -p)",
      "Bash(git add -- *)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git worktree*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push --force*)",
      "Bash(npm publish*)",
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(curl * | bash*)",
      "Bash(wget * | bash*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Create",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-format.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/prevent-secrets.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-code.sh"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": true
}
